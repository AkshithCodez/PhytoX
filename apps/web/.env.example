# ==============================================================================
# PhytoX Web Application - Environment Template (.env.example)
#
# Instructions:
# 1. Copy to .env.local:
#    cp .env.example .env.local
# 2. Fill in your project credentials from your Supabase dashboard.
# 3. Ensure the service-role key is never prefixed with NEXT_PUBLIC_.
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Configuration (Browser & Server)
# ------------------------------------------------------------------------------
# Supabase Project URL (e.g. https://<project-ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co

# Supabase Publishable / Anon API Key (Safe for browser, guarded by RLS)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# Supabase Administrative Persistence (STRICTLY SERVER-ONLY)
# ------------------------------------------------------------------------------
# Privileged service-role key for backend actions (e.g. completing diagnoses, maintenance RPCs)
# WARNING: NEVER add NEXT_PUBLIC_ prefix or expose this credential to the client.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# Application Origin (SERVER-ONLY)
# ------------------------------------------------------------------------------
# Approved mutation origin for CSRF protection
APP_ORIGIN=http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# Machine Learning Inference Service - FastAPI (SERVER-ONLY)
# ------------------------------------------------------------------------------
# Reachable HTTP/HTTPS endpoint of the FastAPI model inference service
INFERENCE_URL=http://127.0.0.1:8000

# Shared secret key passed in X-API-Key header to FastAPI /v1/predict
# Must match INFERENCE_API_KEY in services/inference/.env
INFERENCE_API_KEY=your-shared-inference-api-key

